{
    "compilerOptions": {
        "module": "CommonJS",
        "target": "ES6",
        "paths": {
            "@components/*": ["./src/components/*"],
            "@assets/*": ["./src/assets/*"],
            "@styles/*": ["./src/styles/*"],
            "@data/*": ["./src/data/*"],
            "@sections/*": ["./src/sections/*"],
            "@pages/*": ["./src/pages/*"],
            "@config/*": ["./src/config/*"],
            "@context/*": ["./src/context/*"]
        }
    },
    "exclude": ["node_modules"]
}
